# Copy to .env (not in git). load.sh sets FUSEKI_DB to the database it has just built.
DATA=/data/confref
FUSEKI_HEAP=4g
FUSEKI_DB=/data/confref/fuseki/db-YYYY-MM-DD
# datasets not loaded into Fuseki (comma-separated)
LOAD_SKIP=
# a local test VM: the links of the pages to this VM instead of the production hosts
#CR_ID_BASE=https://localhost
#CR_LABS_BASE=https://localhost
# a test VM loading versions not yet on the dumps location (host/catalog-dataindex.py; paths inside the container)
#CR_DATAINDEX=/store/dataindex.json
#CR_ONTOLOGY_TTL=/store/confref-ontology.ttl
